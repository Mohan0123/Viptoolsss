    <!-- Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // --- Theme Logic ---
            const themeToggle = document.getElementById('themeToggle');
            const html = document.documentElement;
            const themeKey = 'viptool-theme';
            
            // Priority: LocalStorage -> System -> Default (Dark)
            const savedTheme = localStorage.getItem(themeKey);
            const systemPref = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            const initialTheme = savedTheme || systemPref || 'dark';
            
            html.setAttribute('data-theme', initialTheme);

            themeToggle.addEventListener('click', () => {
                const current = html.getAttribute('data-theme');
                const next = current === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', next);
                localStorage.setItem(themeKey, next);
            });

            // --- Calculator Logic ---
            const inputs = {
                country: document.getElementById('countrySelect'),
                price: document.getElementById('originalPrice'),
                discountRange: document.getElementById('discountRange'),
                discountInput: document.getElementById('discountInput'),
                tax: document.getElementById('salesTax')
            };

            const displays = {
                symbol: document.getElementById('currencySymbolDisplay'),
                discountVal: document.getElementById('discountVal'),
                finalPrice: document.getElementById('finalPrice'),
                savedAmount: document.getElementById('savedAmount'),
                taxAmount: document.getElementById('taxAmount')
            };

            // Currency Config
            let currentLocale = 'es-ES';
            let currentCurrency = 'EUR';

            function updateCurrencyConfig() {
                const [currency, locale, symbol] = inputs.country.value.split('|');
                currentCurrency = currency;
                currentLocale = locale;
                displays.symbol.textContent = symbol;
                calculate();
            }

            function calculate() {
                const price = parseFloat(inputs.price.value) || 0;
                const discount = parseFloat(inputs.discountInput.value) || 0;
                const taxRate = parseFloat(inputs.tax.value) || 0;

                // Sync UI
                inputs.discountRange.value = discount;
                displays.discountVal.textContent = discount;

                // Math
                const savings = price * (discount / 100);
                const priceAfterDiscount = price - savings;
                const taxAmt = priceAfterDiscount * (taxRate / 100);
                const final = priceAfterDiscount + taxAmt;

                // Formatting
                const formatter = new Intl.NumberFormat(currentLocale, {
                    style: 'currency',
                    currency: currentCurrency
                });

                displays.finalPrice.textContent = formatter.format(final);
                displays.savedAmount.textContent = formatter.format(savings);
                displays.taxAmount.textContent = taxRate > 0 
                    ? `+ ${formatter.format(taxAmt)} Impuesto` 
                    : `${formatter.format(0)} Impuesto`;
            }

            // Event Listeners
            inputs.country.addEventListener('change', updateCurrencyConfig);
            inputs.price.addEventListener('input', calculate);
            inputs.tax.addEventListener('input', calculate);
            
            inputs.discountRange.addEventListener('input', (e) => {
                inputs.discountInput.value = e.target.value;
                calculate();
            });
            inputs.discountInput.addEventListener('input', (e) => {
                let val = parseFloat(e.target.value);
                if(val > 100) val = 100; 
                if(val < 0) val = 0;
                inputs.discountRange.value = val;
                calculate();
            });

            document.getElementById('resetBtn').addEventListener('click', () => {
                inputs.price.value = '';
                inputs.discountInput.value = 20;
                inputs.discountRange.value = 20;
                inputs.tax.value = '';
                calculate();
            });

            // Initialize
            updateCurrencyConfig();

            // --- Modal Logic ---
            window.openModal = (id) => { document.getElementById(id).classList.add('modal-active'); };
            window.closeModal = (id) => { document.getElementById(id).classList.remove('modal-active'); };
            document.querySelectorAll('.modal-overlay').forEach(m => {
                m.addEventListener('click', (e) => { if(e.target === m) m.classList.remove('modal-active'); });
            });

            // --- Ad Logic ---
            setTimeout(() => {
                document.querySelectorAll('.ad-container').forEach(ad => {
                    if (ad.innerHTML.includes('<ins') || ad.innerHTML.includes('<script')) ad.style.display = 'flex';
                });
            }, 2000);
        });
    </script>
